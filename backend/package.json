{
  "name": "tradeflow-backend",
  "version": "1.0.0",
  "description": "TradeFlow Backend Services and Engines",
  "private": true,
  "scripts": {
    "test": "./scripts/run-tests.sh",
    "test:ci": "./scripts/run-tests.sh --ci",
    "test:nodejs": "./scripts/run-tests.sh --nodejs-only",
    "test:cpp": "./scripts/run-tests.sh --cpp-only",
    "test:coverage": "./scripts/run-tests.sh --coverage-threshold 80",
    "test:functional": "./scripts/run-functional-tests.sh",
    "test:functional:coverage": "./scripts/run-functional-tests.sh --coverage",
    "test:integration": "./scripts/run-integration-tests.sh",
    "test:integration:coverage": "./scripts/run-integration-tests.sh --coverage",
    "test:integration:user": "./scripts/run-integration-tests.sh user-service",
    "test:integration:strategy": "./scripts/run-integration-tests.sh strategy-service",
    "test:integration:market-data": "./scripts/run-integration-tests.sh market-data-service",
    "test:integration:portfolio": "./scripts/run-integration-tests.sh portfolio-service",
    "test:integration:e2e": "./scripts/run-integration-tests.sh end-to-end",
    "test:benchmark": "./scripts/run-benchmark-tests.sh",
    "test:load-stress": "./scripts/run-load-stress-tests.sh",
    "test:security": "./scripts/run-security-tests.sh",
    "test:security:auth": "cd services/api-gateway && npm test -- --testPathPattern='security/auth-bypass.security.test.ts'",
    "test:security:sql": "cd services/api-gateway && npm test -- --testPathPattern='security/sql-injection.security.test.ts'",
    "test:security:rate-limit": "cd services/api-gateway && npm test -- --testPathPattern='security/rate-limiting.security.test.ts'",
    "test:security:csrf": "cd services/api-gateway && npm test -- --testPathPattern='security/session-csrf.security.test.ts'",
    "test:security:vuln-scan": "cd services/api-gateway && npm test -- --testPathPattern='security/vulnerability-scan.security.test.ts'",
    "test:all": "npm run test && npm run test:functional && npm run test:integration && npm run test:security",
    "test:docker": "docker-compose -f docker-compose.test.yml up --build --abort-on-container-exit",
    "test:docker:clean": "docker-compose -f docker-compose.test.yml down -v --remove-orphans",
    "test:performance": "./scripts/performance-regression-detector.sh run",
    "test:performance:baseline": "./scripts/performance-regression-detector.sh update-baseline",
    "test:performance:report": "./scripts/performance-regression-detector.sh report",
    "test:metrics:collect": "./scripts/test-metrics-collector.sh collect",
    "test:metrics:report": "./scripts/test-metrics-collector.sh report",
    "test:metrics:cleanup": "./scripts/test-metrics-collector.sh cleanup",
    "test:data:generate": "./scripts/test-data-manager.sh generate",
    "test:data:seed": "./scripts/test-data-manager.sh seed",
    "test:data:cleanup": "./scripts/test-data-manager.sh cleanup",
    "test:data:full": "./scripts/test-data-manager.sh full",
    "install:all": "npm run install:services && npm run install:shared",
    "install:services": "for dir in services/*/; do (cd \"$dir\" && npm install); done",
    "install:shared": "for dir in shared/*/; do (cd \"$dir\" && npm install); done",
    "build:all": "npm run build:services && npm run build:engines",
    "build:services": "for dir in services/*/; do (cd \"$dir\" && npm run build); done",
    "build:engines": "cd engines && mkdir -p build && cd build && cmake -DCMAKE_BUILD_TYPE=Release .. && make -j$(nproc)",
    "clean": "npm run clean:services && npm run clean:engines",
    "clean:services": "for dir in services/*/; do (cd \"$dir\" && npm run clean 2>/dev/null || rm -rf dist node_modules); done",
    "clean:engines": "rm -rf engines/build",
    "lint": "npm run lint:services",
    "lint:services": "for dir in services/*/; do (cd \"$dir\" && npm run lint 2>/dev/null || echo \"No lint script in $dir\"); done",
    "dev:user-service": "cd services/user-service && npm run dev",
    "dev:api-gateway": "cd services/api-gateway && npm run dev",
    "dev:market-data": "cd services/market-data-service && npm run dev",
    "dev:strategy": "cd services/strategy-service && npm run dev",
    "dev:portfolio": "cd services/portfolio-service && npm run dev",
    "dev:monitoring": "cd services/monitoring-service && npm run dev",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "ci:setup": "./scripts/test-data-manager.sh full && ./scripts/test-metrics-collector.sh collect",
    "ci:test": "npm run test:ci && npm run test:integration && npm run test:security",
    "ci:performance": "./scripts/performance-regression-detector.sh run",
    "ci:cleanup": "npm run test:data:cleanup && npm run test:metrics:cleanup 30",
    "deploy:test": "./scripts/run-deployment-tests.sh",
    "deploy:security-scan": "./scripts/docker-security-scan.sh",
    "deploy:blue-green": "./scripts/blue-green-deployment-test.sh",
    "deploy:smoke-tests": "./scripts/production-smoke-tests.sh",
    "deploy:monitoring": "./scripts/monitoring-validation-tests.sh",
    "deploy:backup-restore": "./scripts/backup-restore-tests.sh",
    "deploy:disaster-recovery": "./scripts/disaster-recovery-tests.sh",
    "deploy:cleanup": "./scripts/run-deployment-tests.sh --cleanup"
  },
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "devDependencies": {
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/tradeflow-backend.git"
  },
  "keywords": [
    "trading",
    "algorithmic-trading",
    "fintech",
    "microservices",
    "nodejs",
    "cpp",
    "high-frequency-trading"
  ],
  "author": "TradeFlow Team",
  "license": "MIT"
}
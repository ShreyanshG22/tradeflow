# =============================================================================
# TradeFlow Zerodha Integration - STAGING Environment
# =============================================================================

# =============================================================================
# ZERODHA API CONFIGURATION (Sandbox/Test)
# =============================================================================
ZERODHA_API_KEY=${ZERODHA_STAGING_API_KEY}
ZERODHA_API_SECRET=${ZERODHA_STAGING_API_SECRET}
ZERODHA_REDIRECT_URL=https://staging.your-domain.com/auth/zerodha/callback

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_URL=${STAGING_DATABASE_URL}
POSTGRES_HOST=${STAGING_DB_HOST}
POSTGRES_PORT=${STAGING_DB_PORT:-5432}
POSTGRES_DB=${STAGING_DB_NAME}
POSTGRES_USER=${STAGING_DB_USER}
POSTGRES_PASSWORD=${STAGING_DB_PASSWORD}
POSTGRES_SSL=true
POSTGRES_MAX_CONNECTIONS=30

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=${STAGING_REDIS_URL}
REDIS_HOST=${STAGING_REDIS_HOST}
REDIS_PORT=${STAGING_REDIS_PORT:-6379}
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1500

# =============================================================================
# INFLUXDB CONFIGURATION
# =============================================================================
INFLUXDB_URL=${STAGING_INFLUXDB_URL}
INFLUXDB_TOKEN=${STAGING_INFLUXDB_TOKEN}
INFLUXDB_ORG=tradeflow-staging
INFLUXDB_BUCKET=market_data_staging
INFLUXDB_USERNAME=${STAGING_INFLUXDB_USERNAME}
INFLUXDB_PASSWORD=${STAGING_INFLUXDB_PASSWORD}

# =============================================================================
# SERVICE PORTS
# =============================================================================
ZERODHA_AUTH_SERVICE_PORT=3009
ZERODHA_MARKET_SERVICE_PORT=3005
ZERODHA_ORDER_SERVICE_PORT=3006
ZERODHA_PORTFOLIO_SERVICE_PORT=3007
ZERODHA_RISK_SERVICE_PORT=3008
ZERODHA_WS_PORT=8080

# =============================================================================
# SERVICE URLS
# =============================================================================
ZERODHA_AUTH_SERVICE_URL=http://zerodha-auth-service:3009
ZERODHA_MARKET_SERVICE_URL=http://zerodha-market-service:3005
ZERODHA_ORDER_SERVICE_URL=http://zerodha-order-service:3006
ZERODHA_PORTFOLIO_SERVICE_URL=http://zerodha-portfolio-service:3007
ZERODHA_RISK_SERVICE_URL=http://zerodha-risk-service:3008

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_EXPIRES_IN=6h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=${STAGING_ENCRYPTION_KEY}
SESSION_SECRET=${STAGING_SESSION_SECRET}

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=staging
LOG_LEVEL=info
DEBUG_MODE=true
ENABLE_CORS=true
CORS_ORIGIN=${STAGING_FRONTEND_URL}

# =============================================================================
# RATE LIMITING (relaxed for testing)
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_ORDER_MAX=200

# =============================================================================
# MARKET DATA CONFIGURATION
# =============================================================================
MARKET_DATA_CACHE_TTL=60
INSTRUMENT_CACHE_TTL=86400
HISTORICAL_DATA_CACHE_TTL=3600
WS_HEARTBEAT_INTERVAL=30000
WS_RECONNECT_INTERVAL=5000
MAX_WS_RECONNECT_ATTEMPTS=15

# =============================================================================
# ORDER MANAGEMENT (test-friendly settings)
# =============================================================================
ORDER_TIMEOUT_MS=30000
ORDER_RETRY_ATTEMPTS=3
ORDER_RETRY_DELAY=1000
MAX_ORDERS_PER_MINUTE=100
ORDER_VALIDATION_TIMEOUT=5000

# =============================================================================
# RISK MANAGEMENT (relaxed for testing)
# =============================================================================
DEFAULT_MAX_ORDER_VALUE=50000
DEFAULT_MAX_DAILY_LOSS=25000
DEFAULT_MAX_POSITION_SIZE=500000
RISK_CHECK_TIMEOUT=5000
PORTFOLIO_UPDATE_INTERVAL=30000

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
METRICS_COLLECTION_INTERVAL=60000
ALERT_WEBHOOK_URL=${STAGING_ALERT_WEBHOOK_URL}
SLACK_WEBHOOK_URL=${STAGING_SLACK_WEBHOOK_URL}

# =============================================================================
# CIRCUIT BREAKER CONFIGURATION
# =============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60000
CIRCUIT_BREAKER_MONITOR_TIMEOUT=10000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_FORMAT=json
LOG_TIMESTAMP=true
LOG_COLORIZE=true
LOG_FILE_PATH=/app/logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=7
LOG_DATE_PATTERN=YYYY-MM-DD

# =============================================================================
# STAGING SPECIFIC
# =============================================================================
ENABLE_HOT_RELOAD=false
ENABLE_DEBUG_ROUTES=true
MOCK_ZERODHA_API=false
ENABLE_API_DOCS=true
API_DOCS_PATH=/docs
ENABLE_TEST_ROUTES=true

# =============================================================================
# TESTING AND QA
# =============================================================================
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DETAILED_LOGGING=true
CAPTURE_REQUEST_BODY=true
ENABLE_MOCK_DATA=true
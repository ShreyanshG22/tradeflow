# Zerodha API Configuration
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/tradeflow
REDIS_URL=redis://localhost:6379

# Service Configuration
PORT=3007
NODE_ENV=development
LOG_LEVEL=info

# Risk Management Configuration
RISK_MAX_ORDER_VALUE=100000
RISK_MAX_DAILY_LOSS=50000
RISK_MAX_POSITION_SIZE=10000
RISK_MAX_ORDERS_PER_MINUTE=10
RISK_ALLOWED_PRODUCTS=CNC,MIS,NRML
RISK_ALLOWED_EXCHANGES=NSE,BSE
# Server Configuration
PORT=3006
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=info
LOG_ENABLE_FILE=true
LOG_ENABLE_ELASTICSEARCH=false
LOG_ENABLE_FLUENTD=false

# Elasticsearch Configuration (optional)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=tradeflow-logs
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Fluentd Configuration (optional)
FLUENTD_HOST=localhost
FLUENTD_PORT=24224
FLUENTD_TAG=tradeflow

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@tradeflow.com
EMAIL_TO=admin@tradeflow.com,ops@tradeflow.com

# Webhook Notifications (optional)
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts

# System Metrics
SYSTEM_METRICS_ENABLED=true
SYSTEM_METRICS_INTERVAL=30000
SYSTEM_METRICS_RETENTION=1000

# Service URLs for Health Checks
USER_SERVICE_URL=http://localhost:3001
API_GATEWAY_URL=http://localhost:3000
STRATEGY_SERVICE_URL=http://localhost:3003
PORTFOLIO_SERVICE_URL=http://localhost:3004
MARKET_DATA_SERVICE_URL=http://localhost:3002

# Database URLs for Health Checks
POSTGRES_URL=postgres://user:password@localhost:5432/tradeflow
REDIS_URL=redis://localhost:6379
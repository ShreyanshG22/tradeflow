# Portfolio Service Specific
PORTFOLIO_UPDATE_INTERVAL=1000
CURRENCY_CACHE_TTL=300
METRICS_INTERVAL=60000
MAX_POSITIONS_PER_PORTFOLIO=1000

# External Services

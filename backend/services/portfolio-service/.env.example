# Portfolio Service Configuration
NODE_ENV=development
PORTFOLIO_SERVICE_PORT=3004

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradeflow
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false
DB_MAX_CONNECTIONS=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

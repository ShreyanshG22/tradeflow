# Test Environment Configuration
NODE_ENV=test
PORT=3003

# Mock Zerodha API Configuration
ZERODHA_API_KEY=test_api_key
ZERODHA_API_SECRET=test_api_secret
ZERODHA_ACCESS_TOKEN=test_access_token

# Test Redis Configuration (use different DB)
REDIS_URL=redis://localhost:6379/1

# Test Database Configuration
DATABASE_URL=postgresql://test:test@localhost:5432/tradeflow_test

# Disable real WebSocket connections in tests
WS_ENABLED=false

# Test Cache Configuration
MARKET_DATA_CACHE_TTL=10
INSTRUMENTS_CACHE_TTL=60
QUOTE_CACHE_TTL=10
SEARCH_CACHE_TTL=30

# Test Logging
LOG_LEVEL=error
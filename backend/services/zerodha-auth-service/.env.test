# Test Environment Configuration
NODE_ENV=test

# Zerodha API Configuration (Test values)
ZERODHA_API_KEY=test_api_key_for_testing
ZERODHA_API_SECRET=test_api_secret_for_testing
ZERODHA_REDIRECT_URL=http://localhost:3000/auth/zerodha/callback

# JWT Configuration
JWT_SECRET=test_jwt_secret_key_for_testing_only_do_not_use_in_production

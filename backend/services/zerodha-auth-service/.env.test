# Database Configuration (Test database)
DATABASE_URL=postgresql://test:test@localhost:5432/tradeflow_test
REDIS_URL=redis://localhost:6379/1

# Service Configuration
PORT=3001

# Encryption (Test key)
ENCRYPTION_KEY=test_encryption_key_32_characters
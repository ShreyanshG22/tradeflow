{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "TradeFlow API Gateway",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:functional": "jest --config jest.functional.config.js",
    "test:functional:watch": "jest --config jest.functional.config.js --watch",
    "test:functional:coverage": "jest --config jest.functional.config.js --coverage",
    "test:failover": "jest --testPathPattern=failover.test.ts --runInBand --detectOpenHandles",
    "test:security": "jest --testPathPattern='security/' --runInBand --detectOpenHandles",
    "test:security:auth": "jest --testPathPattern='security/auth-bypass.security.test.ts' --runInBand",
    "test:security:sql": "jest --testPathPattern='security/sql-injection.security.test.ts' --runInBand",
    "test:security:rate-limit": "jest --testPathPattern='security/rate-limiting.security.test.ts' --runInBand",
    "test:security:csrf": "jest --testPathPattern='security/session-csrf.security.test.ts' --runInBand",
    "test:security:vuln-scan": "jest --testPathPattern='security/vulnerability-scan.security.test.ts' --runInBand",
    "test:all": "npm run test && npm run test:functional && npm run test:security",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.4",
    "redis": "^4.6.10",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.16",
    "socket.io-client": "^4.7.4",
    "nodemon": "^3.0.2",
    "typescript": "^5.2.2",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0"
  }
}
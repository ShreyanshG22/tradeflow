# =============================================================================
# TradeFlow Zerodha Integration Environment Configuration
# =============================================================================

# =============================================================================
# ZERODHA API CONFIGURATION
# =============================================================================
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here
ZERODHA_REDIRECT_URL=http://localhost:3000/auth/zerodha/callback

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_URL=postgresql://tradeflow:tradeflow_dev_password@localhost:5432/tradeflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradeflow
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=tradeflow_dev_password
POSTGRES_SSL=false
POSTGRES_MAX_CONNECTIONS=20

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# =============================================================================
# INFLUXDB CONFIGURATION (for market data)
# =============================================================================
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=tradeflow_admin_token
INFLUXDB_ORG=tradeflow
INFLUXDB_BUCKET=market_data
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=tradeflow_influx_password

# =============================================================================
# SERVICE PORTS
# =============================================================================
ZERODHA_AUTH_SERVICE_PORT=3009
ZERODHA_MARKET_SERVICE_PORT=3005
ZERODHA_ORDER_SERVICE_PORT=3006
ZERODHA_PORTFOLIO_SERVICE_PORT=3007
ZERODHA_RISK_SERVICE_PORT=3008
ZERODHA_WS_PORT=8080

# =============================================================================
# SERVICE URLS (for inter-service communication)
# =============================================================================
ZERODHA_AUTH_SERVICE_URL=http://localhost:3009
ZERODHA_MARKET_SERVICE_URL=http://localhost:3005
ZERODHA_ORDER_SERVICE_URL=http://localhost:3006
ZERODHA_PORTFOLIO_SERVICE_URL=http://localhost:3007
ZERODHA_RISK_SERVICE_URL=http://localhost:3008

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=your_32_character_encryption_key_here
SESSION_SECRET=your_session_secret_key_here

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info
DEBUG_MODE=true
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ORDER_MAX=50

# =============================================================================
# MARKET DATA CONFIGURATION
# =============================================================================
MARKET_DATA_CACHE_TTL=60
INSTRUMENT_CACHE_TTL=86400
HISTORICAL_DATA_CACHE_TTL=3600
WS_HEARTBEAT_INTERVAL=30000
WS_RECONNECT_INTERVAL=5000
MAX_WS_RECONNECT_ATTEMPTS=10

# =============================================================================
# ORDER MANAGEMENT
# =============================================================================
ORDER_TIMEOUT_MS=30000
ORDER_RETRY_ATTEMPTS=3
ORDER_RETRY_DELAY=1000
MAX_ORDERS_PER_MINUTE=60
ORDER_VALIDATION_TIMEOUT=5000

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
DEFAULT_MAX_ORDER_VALUE=100000
DEFAULT_MAX_DAILY_LOSS=50000
DEFAULT_MAX_POSITION_SIZE=1000000
RISK_CHECK_TIMEOUT=3000
PORTFOLIO_UPDATE_INTERVAL=30000

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
METRICS_COLLECTION_INTERVAL=60000
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# =============================================================================
# CIRCUIT BREAKER CONFIGURATION
# =============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60000
CIRCUIT_BREAKER_MONITOR_TIMEOUT=10000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_FORMAT=json
LOG_TIMESTAMP=true
LOG_COLORIZE=false
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# =============================================================================
# DEVELOPMENT SPECIFIC
# =============================================================================
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_ROUTES=true
MOCK_ZERODHA_API=false
ENABLE_API_DOCS=true
API_DOCS_PATH=/docs

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
TEST_DATABASE_URL=postgresql://tradeflow:tradeflow_test_password@localhost:5432/tradeflow_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_ZERODHA_API_KEY=test_api_key
TEST_ZERODHA_API_SECRET=test_api_secret
ENABLE_TEST_ROUTES=false
# =============================================================================
# TradeFlow Zerodha Integration - PRODUCTION Environment
# =============================================================================
# WARNING: This file contains production configuration templates
# DO NOT commit actual secrets to version control
# =============================================================================

# =============================================================================
# ZERODHA API CONFIGURATION
# =============================================================================
ZERODHA_API_KEY=${ZERODHA_API_KEY}
ZERODHA_API_SECRET=${ZERODHA_API_SECRET}
ZERODHA_REDIRECT_URL=https://your-domain.com/auth/zerodha/callback

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_URL=${DATABASE_URL}
POSTGRES_HOST=${DB_HOST}
POSTGRES_PORT=${DB_PORT:-5432}
POSTGRES_DB=${DB_NAME}
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_SSL=true
POSTGRES_MAX_CONNECTIONS=50

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=${REDIS_URL}
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY=2000

# =============================================================================
# INFLUXDB CONFIGURATION
# =============================================================================
INFLUXDB_URL=${INFLUXDB_URL}
INFLUXDB_TOKEN=${INFLUXDB_TOKEN}
INFLUXDB_ORG=${INFLUXDB_ORG}
INFLUXDB_BUCKET=${INFLUXDB_BUCKET}
INFLUXDB_USERNAME=${INFLUXDB_USERNAME}
INFLUXDB_PASSWORD=${INFLUXDB_PASSWORD}

# =============================================================================
# SERVICE PORTS
# =============================================================================
ZERODHA_AUTH_SERVICE_PORT=3009
ZERODHA_MARKET_SERVICE_PORT=3005
ZERODHA_ORDER_SERVICE_PORT=3006
ZERODHA_PORTFOLIO_SERVICE_PORT=3007
ZERODHA_RISK_SERVICE_PORT=3008
ZERODHA_WS_PORT=8080

# =============================================================================
# SERVICE URLS (internal service mesh)
# =============================================================================
ZERODHA_AUTH_SERVICE_URL=http://zerodha-auth-service:3009
ZERODHA_MARKET_SERVICE_URL=http://zerodha-market-service:3005
ZERODHA_ORDER_SERVICE_URL=http://zerodha-order-service:3006
ZERODHA_PORTFOLIO_SERVICE_URL=http://zerodha-portfolio-service:3007
ZERODHA_RISK_SERVICE_URL=http://zerodha-risk-service:3008

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=4h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=${ENCRYPTION_KEY}
SESSION_SECRET=${SESSION_SECRET}

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
LOG_LEVEL=warn
DEBUG_MODE=false
ENABLE_CORS=true
CORS_ORIGIN=${FRONTEND_URL}

# =============================================================================
# RATE LIMITING (stricter for production)
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_ORDER_MAX=100

# =============================================================================
# MARKET DATA CONFIGURATION
# =============================================================================
MARKET_DATA_CACHE_TTL=30
INSTRUMENT_CACHE_TTL=86400
HISTORICAL_DATA_CACHE_TTL=1800
WS_HEARTBEAT_INTERVAL=30000
WS_RECONNECT_INTERVAL=3000
MAX_WS_RECONNECT_ATTEMPTS=20

# =============================================================================
# ORDER MANAGEMENT
# =============================================================================
ORDER_TIMEOUT_MS=15000
ORDER_RETRY_ATTEMPTS=5
ORDER_RETRY_DELAY=500
MAX_ORDERS_PER_MINUTE=120
ORDER_VALIDATION_TIMEOUT=3000

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
DEFAULT_MAX_ORDER_VALUE=${DEFAULT_MAX_ORDER_VALUE:-500000}
DEFAULT_MAX_DAILY_LOSS=${DEFAULT_MAX_DAILY_LOSS:-100000}
DEFAULT_MAX_POSITION_SIZE=${DEFAULT_MAX_POSITION_SIZE:-2000000}
RISK_CHECK_TIMEOUT=2000
PORTFOLIO_UPDATE_INTERVAL=15000

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_INTERVAL=15000
HEALTH_CHECK_TIMEOUT=3000
METRICS_COLLECTION_INTERVAL=30000
ALERT_WEBHOOK_URL=${ALERT_WEBHOOK_URL}
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}

# =============================================================================
# CIRCUIT BREAKER CONFIGURATION
# =============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT=30000
CIRCUIT_BREAKER_MONITOR_TIMEOUT=5000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_FORMAT=json
LOG_TIMESTAMP=true
LOG_COLORIZE=false
LOG_FILE_PATH=/app/logs
LOG_MAX_SIZE=50m
LOG_MAX_FILES=10
LOG_DATE_PATTERN=YYYY-MM-DD-HH

# =============================================================================
# PRODUCTION SPECIFIC
# =============================================================================
ENABLE_HOT_RELOAD=false
ENABLE_DEBUG_ROUTES=false
MOCK_ZERODHA_API=false
ENABLE_API_DOCS=false
TRUST_PROXY=true

# =============================================================================
# SECURITY HEADERS
# =============================================================================
HELMET_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true
REFERRER_POLICY=strict-origin-when-cross-origin